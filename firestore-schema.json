{
  "firestore_schema": {
    "version": "3.1.0",

    "_id_system": {
      "_description": "Every document ID uses a typed prefix + zero-padded 4-digit counter (e.g. usr_0001). Example IDs shown throughout this schema match the seed data in seed.ts. Auth UIDs from Firebase Auth are used as the Firestore document ID for the users collection; userId (usr_0001) is the stable cross-collection reference.",
      "prefixes": {
        "usr_"   : "users (all roles — admin, technician, client)",
        "wo_"    : "workOrders",
        "asmt_"  : "assignments",
        "tl_"    : "assignments/{id}/timeLogs",
        "hist_"  : "workOrders/{id}/history  |  assignments/{id}/history",
        "proj_"  : "projects",
        "ph_"    : "projects/{id}/phases",
        "task_"  : "projects/{id}/phases/{id}/tasks",
        "dl_"    : "projects/{id}/dailyLogs",
        "pdoc_"  : "projects/{id}/documents",
        "wl_"    : "weeklyLogs",
        "wli_"   : "weeklyLogs/{id}/items",
        "creq_"  : "clientRequests",
        "mreq_"  : "manualWorkOrderEntries",
        "fin_"   : "financialRecords",
        "pen_"   : "penaltyEvents",
        "batch_" : "importBatches",
        "notif_" : "notifications",
        "msg_"   : "messages",
        "tor_"   : "timeOffRequests",
        "route_" : "routes",
        "inv_"   : "invoices",
        "plan_"  : "planTiers",
        "site_"  : "sites",
        "sreq_"  : "siteRequests",
        "rpt_"   : "reports"
      }
    },

    "collections": {

      "users": {
        "_description": "All authenticated users — admins, technicians, and clients. Document ID = Firebase Auth UID.",
        "_document_id": "authUid (Firebase Auth UID) — display/reference ID stored as userId e.g. usr_0001",
        "fields": {
          "id": "string (authUid)",
          "userId": "string (usr_0001 — stable human-readable reference ID)",
          "authUid": "string (Firebase Auth UID)",
          "fullName": "string",
          "email": "string",
          "phone": "string | null",
          "avatarUrl": "string | null",
          "role": "string (admin | technician | client)",
          "status": "string (active | inactive | suspended)",
          "reliabilityScore": "number (0–100) | null — technicians only",
          "reliabilityStatus": "string (reliable | at_risk | restricted) | null — technicians only",
          "penaltyPoints30d": "number | null — technicians only",
          "hourlyRate": "number | null — technicians only",
          "skills": "string[] | null — technicians only",
          "address": "string | null",
          "emergencyContact": {
            "name": "string",
            "relation": "string",
            "phone": "string"
          },
          "availability": {
            "monday":    { "start": "string (HH:MM) | null", "end": "string (HH:MM) | null" },
            "tuesday":   { "start": "string | null", "end": "string | null" },
            "wednesday": { "start": "string | null", "end": "string | null" },
            "thursday":  { "start": "string | null", "end": "string | null" },
            "friday":    { "start": "string | null", "end": "string | null" },
            "saturday":  { "start": "string | null", "end": "string | null" },
            "sunday":    { "start": "string | null", "end": "string | null" }
          },
          "workPreferences": {
            "preferredRadius": "number | null",
            "maxTravelDistance": "number | null",
            "preferredJobTypes": "string[] | null",
            "availabilityOverride": "boolean | null"
          },
          "payoutPreferences": {
            "method": "string (ach | check | zelle | venmo) | null",
            "notes": "string | null"
          },
          "clientCompany": "string | null — clients only",
          "businessType": "string | null — clients only",
          "planId": "string (plan_0001) | null — clients only",
          "subscriptionStatus": "string (active | inactive | trial) | null — clients only",
          "billingContact": {
            "name": "string | null",
            "email": "string | null",
            "terms": "string | null",
            "deliveryMethod": "string (email | mail | portal) | null"
          },
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },

      "workOrders": {
        "_description": "The job itself — title, location, scheduling, client, and source. A workOrder can have one or more assignments (one per assigned tech). May optionally belong to a project.",
        "_document_id": "wo_0001",
        "fields": {
          "id": "string (wo_0001)",
          "title": "string",
          "description": "string | null",
          "locationText": "string",
          "siteGeo": {
            "lat": "number | null",
            "lng": "number | null"
          },
          "gpsRequired": "boolean",
          "source": "string (field_nation | client_portal | aaromach | manual)",
          "importBatchId": "string (batch_0001) | null",
          "externalWorkOrderId": "string | null — source system reference",
          "clientId": "string (usr_0001) | null",
          "clientName": "string | null — denormalized",
          "projectId": "string (proj_0001) | null — null if standalone",
          "assignedTechIds": "string[] (usr_0001)",
          "requiredSkills": "string[]",
          "jobType": "string (installation | troubleshooting | maintenance | survey | repair | decommission | follow_up)",
          "priority": "string (low | normal | high | critical)",
          "status": "string (unassigned | assigned | confirmed | on-my-way | in-progress | completed | cancelled)",
          "isOpenForScheduling": "boolean",
          "scheduleDate": "string (YYYY-MM-DD) | null",
          "scheduleTime": "string (HH:MM) | null",
          "confirmedStartAt": "timestamp | null",
          "pay": "number | null",
          "payType": "string (fixed | hourly | blended) | null",
          "finalPay": "number | null",
          "revisitCount": "number",
          "latestOutcomeCode": "string (worked_completed | worked_revisit_same_work_order | did_not_work | other) | null",
          "notes": "string | null",
          "createdBy": "string (usr_0001)",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        },
        "subcollections": {
          "history": {
            "_description": "Audit trail of every status change or edit on this work order.",
            "_document_id": "hist_0001",
            "fields": {
              "id": "string (hist_0001)",
              "eventType": "string (created | status_changed | rescheduled | assigned | reassigned | cancelled | pay_changed)",
              "fromValue": "string | null",
              "toValue": "string",
              "note": "string | null",
              "changedBy": "string (usr_0001)",
              "changedAt": "timestamp"
            }
          }
        }
      },

      "assignments": {
        "_description": "The pairing of a technician to a workOrder. One workOrder can produce multiple assignment records. Assignments may optionally belong to a project.",
        "_document_id": "asmt_0001",
        "fields": {
          "id": "string (asmt_0001)",
          "workOrderId": "string (wo_0001)",
          "projectId": "string (proj_0001) | null",
          "techId": "string (usr_0001)",
          "techName": "string — denormalized for display",
          "status": "string (scheduled | acknowledged | on-my-way | in-progress | completed | cancelled | removed)",
          "acknowledgmentStatus": "string (pending | acknowledged | missed)",
          "scheduledAt": "timestamp",
          "acknowledgedAt": "timestamp | null",
          "acknowledgmentRequiredAt": "timestamp | null",
          "currentScheduledDate": "timestamp",
          "latestOutcomeCode": "string (worked_completed | worked_revisit_same_work_order | did_not_work | other) | null",
          "needsAdminReview": "boolean",
          "revisitCount": "number",
          "active": "boolean",
          "acknowledgmentMissed": "boolean",
          "removedAfterAcknowledgment": "boolean",
          "removedAt": "timestamp | null",
          "removedBy": "string (usr_0001) | null",
          "removalReasonCode": "string | null",
          "assignedBy": "string (usr_0001)",
          "assignedAt": "timestamp",
          "updatedAt": "timestamp"
        },
        "subcollections": {
          "timeLogs": {
            "_description": "GPS check-in/check-out records for this assignment. One document per tech visit.",
            "_document_id": "tl_0001",
            "fields": {
              "id": "string (tl_0001)",
              "assignmentId": "string (asmt_0001)",
              "workOrderId": "string (wo_0001)",
              "techId": "string (usr_0001)",
              "source": "string (gps | manual | client_portal)",
              "checkInAt": "timestamp | null",
              "checkOutAt": "timestamp | null",
              "checkInLocation": {
                "lat": "number | null",
                "lng": "number | null",
                "accuracyMeters": "number | null"
              },
              "checkOutLocation": {
                "lat": "number | null",
                "lng": "number | null",
                "accuracyMeters": "number | null"
              },
              "distanceFromSiteMetersAtCheckIn": "number | null",
              "distanceFromSiteMetersAtCheckOut": "number | null",
              "gpsValidationStatus": "string (pending | valid | exception)",
              "gpsExceptionReason": "string | null",
              "onSiteCheckIn": "boolean | null",
              "onSiteCheckOut": "boolean | null",
              "lateCheckIn": "boolean",
              "minutesWorked": "number | null",
              "status": "string (checked_in | checked_out | incomplete)",
              "note": "string | null",
              "createdAt": "timestamp",
              "updatedAt": "timestamp"
            }
          },
          "history": {
            "_description": "Audit trail of reschedules, removals, and status changes on this assignment.",
            "_document_id": "hist_0001",
            "fields": {
              "id": "string (hist_0001)",
              "eventType": "string (assigned | rescheduled | acknowledged | removed | completed | cancelled | status_changed)",
              "oldScheduledDate": "timestamp | null",
              "newScheduledDate": "timestamp | null",
              "reasonCode": "string | null",
              "note": "string | null",
              "changedBy": "string (usr_0001)",
              "changedAt": "timestamp"
            }
          }
        }
      },

      "routes": {
        "_description": "A named group of work orders dispatched to one technician on one day.",
        "_document_id": "route_0001",
        "fields": {
          "id": "string (route_0001)",
          "name": "string",
          "techId": "string (usr_0001)",
          "techName": "string — denormalized",
          "workOrderIds": "string[] (wo_0001)",
          "date": "string (YYYY-MM-DD)",
          "createdBy": "string (usr_0001)",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },

      "projects": {
        "_description": "Cumulative job folder grouping multiple work orders and assignments under one engagement. Not all work orders belong to a project.",
        "_document_id": "proj_0001",
        "fields": {
          "id": "string (proj_0001)",
          "title": "string",
          "clientId": "string (usr_0001) | null",
          "clientName": "string | null — denormalized",
          "location": "string",
          "siteIds": "string[] (site_0001)",
          "status": "string (active | on-hold | completed | cancelled)",
          "projectType": "string (quoted_project | service_contract | time_and_materials)",
          "scopeSummary": "string | null",
          "expectedOutcome": "string | null",
          "criticalNotes": "string | null",
          "onsiteContact": "string | null",
          "siteAccessInstructions": "string | null",
          "siteHazardNotes": "string | null",
          "projectLeadId": "string (usr_0001)",
          "crewIds": "string[] (usr_0001)",
          "workOrderIds": "string[] (wo_0001) — all work orders grouped under this project",
          "targetStartDate": "string (YYYY-MM-DD)",
          "targetEndDate": "string (YYYY-MM-DD)",
          "quotedAmount": "number | null",
          "estLaborHours": "number | null",
          "estMaterialCost": "number | null",
          "actualBudget": "number | null",
          "actualHours": "number | null",
          "progressPct": "number (0–100)",
          "createdBy": "string (usr_0001)",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        },
        "subcollections": {
          "phases": {
            "_description": "Ordered phases of work within this project.",
            "_document_id": "ph_0001",
            "fields": {
              "id": "string (ph_0001)",
              "projectId": "string (proj_0001)",
              "name": "string",
              "description": "string | null",
              "order": "number",
              "status": "string (pending | in-progress | completed | skipped)",
              "plannedStartDate": "string (YYYY-MM-DD) | null",
              "plannedEndDate": "string (YYYY-MM-DD) | null",
              "notes": "string | null",
              "photoUrls": "string[]",
              "createdAt": "timestamp",
              "updatedAt": "timestamp"
            },
            "subcollections": {
              "tasks": {
                "_description": "Individual checklist tasks within this phase.",
                "_document_id": "task_0001",
                "fields": {
                  "id": "string (task_0001)",
                  "projectId": "string (proj_0001)",
                  "phaseId": "string (ph_0001)",
                  "name": "string",
                  "description": "string | null",
                  "order": "number",
                  "status": "string (not_started | in-progress | completed | blocked)",
                  "assignedTechIds": "string[] (usr_0001)",
                  "requiresPhoto": "boolean",
                  "requiresText": "boolean",
                  "requiresNumeric": "boolean",
                  "requiresDropdown": "boolean",
                  "dropdownOptions": "string[] | null",
                  "requiresSignature": "boolean",
                  "requiresFileUpload": "boolean",
                  "requiresOther": "boolean",
                  "otherRequirementLabel": "string | null",
                  "estimatedHours": "number | null",
                  "refImageUrls": "string[]",
                  "completionPhotoUrls": "string[]",
                  "notes": "string | null",
                  "createdAt": "timestamp",
                  "updatedAt": "timestamp"
                }
              }
            }
          },
          "dailyLogs": {
            "_description": "Daily technician progress entries for this project.",
            "_document_id": "dl_0001",
            "fields": {
              "id": "string (dl_0001)",
              "projectId": "string (proj_0001)",
              "assignmentId": "string (asmt_0001) | null",
              "techId": "string (usr_0001)",
              "logDate": "string (YYYY-MM-DD)",
              "hoursWorked": "number",
              "workSummary": "string",
              "phaseIdsWorked": "string[] (ph_0001)",
              "taskIdsCompleted": "string[] (task_0001)",
              "taskIdsProgressed": "string[] (task_0001)",
              "issues": "string | null",
              "materialsUsed": "string[]",
              "photoUrls": "string[]",
              "createdAt": "timestamp",
              "updatedAt": "timestamp"
            }
          },
          "documents": {
            "_description": "Files and documents attached to this project, optionally scoped to a phase or task.",
            "_document_id": "pdoc_0001",
            "fields": {
              "id": "string (pdoc_0001)",
              "projectId": "string (proj_0001)",
              "name": "string",
              "type": "string (pdf | img | doc | csv | other)",
              "label": "string | null",
              "uploadedBy": "string (usr_0001)",
              "uploadDate": "string (YYYY-MM-DD)",
              "size": "string | null",
              "phaseId": "string (ph_0001) | null",
              "taskId": "string (task_0001) | null",
              "url": "string (Firebase Storage URL)"
            }
          }
        }
      },

      "weeklyLogs": {
        "_description": "Weekly payroll and work-verification records. One per technician per week.",
        "_document_id": "wl_0001",
        "fields": {
          "id": "string (wl_0001)",
          "techId": "string (usr_0001)",
          "techName": "string — denormalized",
          "weekStartDate": "timestamp (Monday 00:00:00)",
          "weekEndDate": "timestamp (Sunday 23:59:59)",
          "dueAt": "timestamp",
          "status": "string (draft | submitted | approved | rejected)",
          "syncStatus": "string (live | snapshot)",
          "locked": "boolean",
          "snapshotTakenAt": "timestamp | null",
          "totalPayout": "number | null",
          "submittedAt": "timestamp | null",
          "reviewedAt": "timestamp | null",
          "reviewedBy": "string (usr_0001) | null",
          "adminNotes": "string | null",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        },
        "subcollections": {
          "items": {
            "_description": "One item per assignment covered in this weekly log.",
            "_document_id": "wli_0001",
            "fields": {
              "id": "string (wli_0001)",
              "weeklyLogId": "string (wl_0001)",
              "assignmentId": "string (asmt_0001)",
              "workOrderId": "string (wo_0001)",
              "techId": "string (usr_0001)",
              "displayTitle": "string — denormalized workOrder title",
              "displayLocationText": "string — denormalized",
              "displayScheduledDate": "timestamp",
              "didWork": "boolean",
              "isCompleted": "boolean",
              "outcomeCode": "string (worked_completed | worked_revisit_same_work_order | did_not_work | other) | null",
              "didNotWorkReasonCode": "string | null",
              "incompleteReasonCode": "string (revisit_same_work_order | pending_parts | site_not_ready | other) | null",
              "needsAdminReview": "boolean",
              "reviewNote": "string | null",
              "createdAt": "timestamp",
              "updatedAt": "timestamp"
            }
          }
        }
      },

      "clientRequests": {
        "_description": "Service requests submitted by clients through the client portal (Tickets). Approved requests are converted into a workOrder.",
        "_document_id": "creq_0001",
        "fields": {
          "id": "string (creq_0001)",
          "clientId": "string (usr_0001)",
          "clientName": "string — denormalized",
          "createdBy": "string (usr_0001)",
          "title": "string",
          "description": "string",
          "locationText": "string",
          "requestType": "string (installation | troubleshooting | maintenance | survey | repair | decommission | follow_up | other)",
          "priority": "string (low | normal | high | critical)",
          "preferredDate": "timestamp | null",
          "attachments": "string[] (Firebase Storage URLs)",
          "status": "string (pending | reviewed | approved | rejected | converted | closed)",
          "convertedWorkOrderId": "string (wo_0001) | null",
          "convertedAt": "timestamp | null",
          "convertedBy": "string (usr_0001) | null",
          "adminNotes": "string | null",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },

      "manualWorkOrderEntries": {
        "_description": "Internal job requests created by admins or managers — not from client portal or import. Converted into a workOrder on approval.",
        "_document_id": "mreq_0001",
        "fields": {
          "id": "string (mreq_0001)",
          "createdBy": "string (usr_0001)",
          "title": "string",
          "description": "string",
          "locationText": "string",
          "requestType": "string (installation | troubleshooting | maintenance | follow_up | other)",
          "priority": "string (low | normal | high | critical)",
          "preferredDate": "timestamp | null",
          "status": "string (pending | converted | cancelled)",
          "convertedWorkOrderId": "string (wo_0001) | null",
          "convertedAt": "timestamp | null",
          "convertedBy": "string (usr_0001) | null",
          "notes": "string | null",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },

      "financialRecords": {
        "_description": "Reimbursements, payouts, and penalties tied to assignments and weekly logs.",
        "_document_id": "fin_0001",
        "fields": {
          "id": "string (fin_0001)",
          "type": "string (reimbursement | payout | penalty)",
          "techId": "string (usr_0001)",
          "workOrderId": "string (wo_0001) | null",
          "assignmentId": "string (asmt_0001) | null",
          "weeklyLogId": "string (wl_0001) | null",
          "weeklyLogItemId": "string (wli_0001) | null",
          "projectId": "string (proj_0001) | null",
          "amount": "number",
          "category": "string (materials | travel | meals | tools | labor | penalty | other)",
          "note": "string | null",
          "receiptUrls": "string[]",
          "reviewStatus": "string (pending | approved | rejected)",
          "paymentStatus": "string (unpaid | paid | voided)",
          "createdBy": "string (usr_0001)",
          "createdAt": "timestamp",
          "reviewedBy": "string (usr_0001) | null",
          "reviewedAt": "timestamp | null"
        }
      },

      "penaltyEvents": {
        "_description": "Reliability penalty point events recorded against a technician. Drives reliabilityScore and reliabilityStatus on the user.",
        "_document_id": "pen_0001",
        "fields": {
          "id": "string (pen_0001)",
          "techId": "string (usr_0001)",
          "type": "string (missed_acknowledgment | late_log | no_show | late_checkin | gps_exception | other)",
          "points": "number",
          "assignmentId": "string (asmt_0001) | null",
          "workOrderId": "string (wo_0001) | null",
          "weeklyLogId": "string (wl_0001) | null",
          "recordedBy": "string (usr_0001)",
          "note": "string | null",
          "createdAt": "timestamp"
        }
      },

      "importBatches": {
        "_description": "Records of CSV/external import runs (e.g. Field Nation bulk uploads).",
        "_document_id": "batch_0001",
        "fields": {
          "id": "string (batch_0001)",
          "source": "string (field_nation_csv | other)",
          "fileName": "string",
          "uploadedBy": "string (usr_0001)",
          "uploadedAt": "timestamp",
          "rowCount": "number",
          "createdCount": "number",
          "updatedCount": "number",
          "duplicateCount": "number",
          "status": "string (processing | completed | failed)",
          "notes": "string | null"
        }
      },

      "invoices": {
        "_description": "Client-facing invoices tied to projects or individual work orders.",
        "_document_id": "inv_0001",
        "fields": {
          "id": "string (inv_0001)",
          "invoiceNumber": "string (human-readable e.g. INV-0001)",
          "clientId": "string (usr_0001)",
          "clientName": "string — denormalized",
          "projectId": "string (proj_0001) | null",
          "workOrderId": "string (wo_0001) | null",
          "issueDate": "string (YYYY-MM-DD)",
          "dueDate": "string (YYYY-MM-DD)",
          "status": "string (draft | sent | paid | overdue | void)",
          "lineItems": [
            {
              "id": "string",
              "description": "string",
              "quantity": "number",
              "unitPrice": "number"
            }
          ],
          "notes": "string | null",
          "subtotal": "number",
          "tax": "number",
          "total": "number",
          "createdBy": "string (usr_0001)",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },

      "planTiers": {
        "_description": "Subscription plan tiers available to client accounts.",
        "_document_id": "plan_0001",
        "fields": {
          "id": "string (plan_0001)",
          "name": "string (e.g. On-Call | Site Partner | Dedicated)",
          "price": "number",
          "billingPeriod": "string (monthly | annual)",
          "features": "string[]",
          "siteLimit": "number",
          "responseTime": "string",
          "type": "string (standard | custom)",
          "clientId": "string (usr_0001) | null — set only for custom plans",
          "clientName": "string | null",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },

      "sites": {
        "_description": "Physical managed sites belonging to a client. Requested via siteRequests, activated by admin.",
        "_document_id": "site_0001",
        "fields": {
          "id": "string (site_0001)",
          "clientId": "string (usr_0001)",
          "clientName": "string — denormalized",
          "siteName": "string",
          "locationText": "string",
          "siteGeo": {
            "lat": "number | null",
            "lng": "number | null"
          },
          "managerName": "string | null",
          "managerPhone": "string | null",
          "siteAccessInstructions": "string | null",
          "status": "string (active | inactive | pending)",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },

      "siteRequests": {
        "_description": "Client requests to add a new managed site. Approved requests create a site_ document.",
        "_document_id": "sreq_0001",
        "fields": {
          "id": "string (sreq_0001)",
          "clientId": "string (usr_0001)",
          "clientName": "string — denormalized",
          "siteName": "string",
          "locationText": "string",
          "managerName": "string",
          "managerPhone": "string",
          "status": "string (pending | approved | denied)",
          "convertedSiteId": "string (site_0001) | null",
          "reviewedBy": "string (usr_0001) | null",
          "reviewedAt": "timestamp | null",
          "createdAt": "timestamp",
          "updatedAt": "timestamp"
        }
      },

      "notifications": {
        "_description": "Scheduled or triggered notifications sent to users.",
        "_document_id": "notif_0001",
        "fields": {
          "id": "string (notif_0001)",
          "userId": "string (usr_0001)",
          "type": "string (weekly_log_reminder | acknowledgment_reminder | assignment_update | penalty_issued | general)",
          "relatedId": "string | null",
          "relatedEntityType": "string (workOrder | assignment | weeklyLog | project) | null",
          "channel": "string (email | push | sms)",
          "scheduledFor": "timestamp",
          "sentAt": "timestamp | null",
          "attemptCount": "number",
          "lastAttemptAt": "timestamp | null",
          "deliveryStatus": "string (queued | sent | delivered | failed)",
          "deliveryError": "string | null",
          "message": "string"
        }
      },

      "messages": {
        "_description": "In-app messages between admins and technicians or clients.",
        "_document_id": "msg_0001",
        "fields": {
          "id": "string (msg_0001)",
