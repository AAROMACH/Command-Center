
{
  "firestore_schema": {
    "version": "3.2.0",
    "_id_system": {
      "prefixes": {
        "usr_"   : "users",
        "wo_"    : "workOrders",
        "asmt_"  : "assignments",
        "wl_"    : "weeklyLogs",
        "wli_"   : "weeklyLogs/{id}/items",
        "proj_"  : "projects"
      }
    },
    "collections": {
      "users": {
        "fields": {
          "id": "string",
          "userId": "string",
          "role": "string",
          "status": "string",
          "reliabilityScore": "number"
        }
      },
      "weeklyLogs": {
        "fields": {
          "id": "string",
          "technicianId": "string",
          "weekOf": "string",
          "status": "string (Draft | Submitted | Approved | Rejected)",
          "totalPayout": "number"
        },
        "subcollections": {
          "items": {
            "fields": {
              "id": "string",
              "workOrderId": "string",
              "jobPay": "number (snapshot of pay at completion)",
              "confirmationStatus": "string (confirmed | disputed) | null",
              "disputeReason": "string | null",
              "isComplete": "boolean",
              "isAdminReviewed": "boolean"
            }
          }
        }
      }
    }
  }
}
