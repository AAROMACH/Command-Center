rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let d = userData();
      return d.get('roles', []).hasAny(['super_admin', 'dispatch_admin', 'payroll_admin', 'project_manager'])
          || d.get('role', '') in ['admin', 'super_admin', 'dispatch_admin', 'payroll_admin', 'project_manager'];
    }

    function isSuperAdmin() {
      let d = userData();
      return d.get('roles', []).hasAny(['super_admin']) || d.get('role', '') == 'super_admin';
    }

    function isPayrollAdmin() {
      let d = userData();
      return d.get('roles', []).hasAny(['super_admin', 'payroll_admin'])
          || d.get('role', '') in ['super_admin', 'payroll_admin'];
    }

    function isTech() {
      let d = userData();
      return d.get('roles', []).hasAny(['project_lead', 'field_technician'])
          || d.get('role', '') in ['tech', 'project_lead', 'field_technician'];
    }

    function isClient() {
      let d = userData();
      return d.get('roles', []).hasAny(['client']) || d.get('role', '') == 'client';
    }

    // users
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSuperAdmin();
      allow update: if isAdmin()
          || (isSignedIn() && request.auth.uid == userId
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['roles', 'role', 'reliabilityScore', 'reliabilityTier', 'status', 'payoutPreferences']));
      allow delete: if isSuperAdmin();
    }

    // assignments — tech queries: where('techId', '==', uid)
    match /assignments/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
          || (isClient() && resource.data.clientId == request.auth.uid)
      );
      allow create: if isAdmin();
      allow update: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // workOrders — ghost collection; tech matched on techId or assignedTechnicianId
    match /workOrders/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && (resource.data.techId == request.auth.uid
              || resource.data.assignedTechnicianId == request.auth.uid))
          || (isClient() && resource.data.clientId == request.auth.uid)
      );
      allow create: if isAdmin();
      allow update: if isAdmin()
          || (isTech() && (resource.data.techId == request.auth.uid
              || resource.data.assignedTechnicianId == request.auth.uid));
      allow delete: if isAdmin();
    }

    // weeklyLogs — tech queries: where('techId', '==', uid)
    match /weeklyLogs/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech();
      allow update: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid
              && resource.data.status == 'Draft');
      allow delete: if isSuperAdmin();
    }

    // projectDailyLogs — tech queries: where('techId', '==', uid)
    match /projectDailyLogs/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech() || isAdmin();
      allow update: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // projects — techs see all (team filtering is client-side); clients scoped by clientId
    match /projects/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || isTech()
          || (isClient() && resource.data.clientId == request.auth.uid)
      );
      allow create: if isAdmin();
      allow update: if isAdmin() || isTech();
      allow delete: if isSuperAdmin();
    }

    // projectDocuments — queried by projectId; internal to admins and techs
    match /projectDocuments/{id} {
      allow read: if isSignedIn() && (isAdmin() || isTech());
      allow create: if isAdmin() || isTech();
      allow delete: if isAdmin();
    }

    // clientRequests — client queries: where('clientName', '==', clientCompany)
    match /clientRequests/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && resource.data.clientName == userData().clientCompany)
      );
      allow create: if isSignedIn() && (isClient() || isAdmin());
      allow update: if isAdmin()
          || (isClient() && resource.data.clientName == userData().clientCompany
              && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // siteRequests — client queries: where('clientName', '==', clientCompany)
    match /siteRequests/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && resource.data.clientName == userData().clientCompany)
      );
      allow create: if isSignedIn() && (isClient() || isAdmin());
      allow update: if isAdmin()
          || (isClient() && resource.data.clientName == userData().clientCompany
              && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // invoices — client queries: where('clientName', '==', clientName)
    match /invoices/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && resource.data.clientName == userData().clientCompany)
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // sites — admin + owning client only
    match /sites/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && resource.data.clientId == request.auth.uid)
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // timeOffRequests — admin reads all; techs create only
    match /timeOffRequests/{id} {
      allow read: if isAdmin();
      allow create: if isTech();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // notifications — any signed-in user can create; admin manages
    match /notifications/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // messages — admin broadcast; any signed-in user can read
    match /messages/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // planTiers — pricing data; any signed-in user can read
    match /planTiers/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // financialRecords — payroll admin only
    match /financialRecords/{id} {
      allow read, write: if isPayrollAdmin();
    }

    // penaltyEvents — payroll admin only
    match /penaltyEvents/{id} {
      allow read, write: if isPayrollAdmin();
    }
  }
}
