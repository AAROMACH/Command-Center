rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let d = userData();
      return d.get('roles', []).hasAny(['super_admin', 'dispatch_admin', 'payroll_admin', 'project_manager'])
          || d.get('role', '') in ['admin', 'super_admin', 'dispatch_admin', 'payroll_admin', 'project_manager'];
    }

    function isSuperAdmin() {
      let d = userData();
      return d.get('roles', []).hasAny(['super_admin']) || d.get('role', '') == 'super_admin';
    }

    function isPayrollAdmin() {
      let d = userData();
      return d.get('roles', []).hasAny(['super_admin', 'payroll_admin'])
          || d.get('role', '') in ['super_admin', 'payroll_admin'];
    }

    function isTech() {
      let d = userData();
      return d.get('roles', []).hasAny(['project_lead', 'field_technician'])
          || d.get('role', '') in ['tech', 'project_lead', 'field_technician'];
    }

    function isClient() {
      let d = userData();
      return d.get('roles', []).hasAny(['client']) || d.get('role', '') == 'client';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSuperAdmin();
      allow update: if isAdmin()
          || (isSignedIn() && request.auth.uid == userId
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['roles', 'role', 'reliabilityScore', 'reliabilityTier', 'status', 'payoutPreferences']));
      allow delete: if isSuperAdmin();
    }

    match /assignments/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
          || (isClient() && resource.data.clientId == request.auth.uid)
      );
      allow create: if isAdmin();
      allow update: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /workOrders/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && (resource.data.techId == request.auth.uid
              || resource.data.assignedTechnicianId == request.auth.uid))
          || (isClient() && resource.data.clientId == request.auth.uid)
      );
      allow create: if isAdmin();
      allow update: if isAdmin()
          || (isTech() && (resource.data.techId == request.auth.uid
              || resource.data.assignedTechnicianId == request.auth.uid));
      allow delete: if isAdmin();
    }

    match /weeklyLogs/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech();
      allow update: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid
              && resource.data.status == 'Draft');
      allow delete: if isSuperAdmin();
    }

    match /weeklyLogItems/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech() || isAdmin();
      allow update: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /projectDailyLogs/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech() || isAdmin();
      allow update: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /projects/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || isTech()
          || (isClient() && resource.data.clientId == request.auth.uid)
      );
      allow create: if isAdmin();
      allow update: if isAdmin() || isTech();
      allow delete: if isSuperAdmin();
    }

    match /projectDocuments/{id} {
      allow read: if isSignedIn() && (isAdmin() || isTech());
      allow create: if isAdmin() || isTech();
      allow delete: if isAdmin();
    }

    match /clients/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && resource.data.uid == request.auth.uid)
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /clientRequests/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && resource.data.clientName == userData().clientCompany)
      );
      allow create: if isSignedIn() && (isClient() || isAdmin());
      allow update: if isAdmin()
          || (isClient() && resource.data.clientName == userData().clientCompany
              && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    match /siteRequests/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && resource.data.clientName == userData().clientCompany)
      );
      allow create: if isSignedIn() && (isClient() || isAdmin());
      allow update: if isAdmin()
          || (isClient() && resource.data.clientName == userData().clientCompany
              && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    match /sites/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && resource.data.clientId == request.auth.uid)
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /invoices/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && resource.data.clientName == userData().clientCompany)
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /reimbursements/{id} {
      allow read: if isSignedIn() && (
          isPayrollAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech() || isAdmin();
      allow update: if isPayrollAdmin();
      allow delete: if isSuperAdmin();
    }

    match /timeOffRequests/{id} {
      allow read: if isAdmin();
      allow create: if isTech();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /importBatches/{id} {
      allow read, write: if isAdmin();
    }

    match /missingReports/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /broadcasts/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /systemConfig/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /messages/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /planTiers/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /financialRecords/{id} {
      allow read, write: if isPayrollAdmin();
    }

    match /penaltyEvents/{id} {
      allow read, write: if isPayrollAdmin();
    }

    match /expenses/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech() || isAdmin();
      allow update: if isPayrollAdmin()
          || (isTech() && resource.data.techId == request.auth.uid);
      allow delete: if isPayrollAdmin();
    }

    match /reliabilityEvents/{id} {
      allow read: if isSignedIn() && (isAdmin() || isTech());
      allow write: if isAdmin();
    }
  }
}