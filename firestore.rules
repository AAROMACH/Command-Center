rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let d = userData();
      return d.get('roles', []).hasAny(['super_admin', 'dispatch_admin', 'payroll_admin', 'project_manager'])
          || d.get('role', '') in ['admin', 'super_admin', 'dispatch_admin', 'payroll_admin', 'project_manager'];
    }

    function isSuperAdmin() {
      let d = userData();
      return d.get('roles', []).hasAny(['super_admin']) || d.get('role', '') == 'super_admin';
    }

    function isPayrollAdmin() {
      let d = userData();
      return d.get('roles', []).hasAny(['super_admin', 'payroll_admin'])
          || d.get('role', '') in ['super_admin', 'payroll_admin'];
    }

    function isTech() {
      let d = userData();
      return d.get('roles', []).hasAny(['project_lead', 'field_technician'])
          || d.get('role', '') in ['tech', 'project_lead', 'field_technician'];
    }

    function isClient() {
      let d = userData();
      return d.get('roles', []).hasAny(['client']) || d.get('role', '') == 'client';
    }

    function isSales() {
      let d = userData();
      return d.get('roles', []).hasAny(['sales']) || d.get('role', '') == 'sales';
    }

    // ── Messaging permission enforcement ────────────────────────────────
    // Mirrors the recipient-picker logic: the sender's messagingAllowedRoles
    // and per-user blocklist gate who they may message. Admins are exempt.
    function receiverRoles(receiverId) {
      return get(/databases/$(database)/documents/users/$(receiverId)).data.get('roles', []);
    }
    function messagingRoleAllowed(allowed, receiverId) {
      return allowed == 'all'
        || (allowed == 'admins' && receiverRoles(receiverId).hasAny(['super_admin', 'dispatch_admin', 'payroll_admin', 'project_manager']))
        || (allowed == 'techs'  && receiverRoles(receiverId).hasAny(['field_technician', 'project_lead']))
        || (allowed == 'clients' && receiverRoles(receiverId).hasAny(['client']));
    }
    function canMessage(receiverId) {
      let d = userData();
      let allowed = d.get('messagingAllowedRoles', 'all');
      let blocked = d.get('messagingBlockedClientIds', []);
      return allowed != 'none'
        && !blocked.hasAny([receiverId])
        && (
            // The generic "admin" channel is allowed when admins are permitted
            (receiverId == 'admin' && (allowed == 'all' || allowed == 'admins'))
            // Real user recipients are checked against their roles
            || (receiverId != 'admin' && messagingRoleAllowed(allowed, receiverId))
           );
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin()
          || (request.auth != null
              && request.auth.uid == userId
              && request.resource.data.approvalStatus == 'pending'
              && !request.resource.data.keys().hasAny(['role'])
              && (!request.resource.data.keys().hasAny(['roles'])
                  || request.resource.data.roles.size() == 0));
      allow update: if isAdmin()
          || (isSignedIn() && request.auth.uid == userId
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['roles', 'role', 'reliabilityScore', 'reliabilityTier', 'status', 'accountStatus',
                            'payoutPreferences', 'hourlyRate', 'adminNotes', 'updatedBy',
                            'approvalStatus', 'approvedAt', 'approvedBy', 'deniedAt', 'deniedBy', 'denialReason',
                            'portalAccess', 'primaryPortal', 'permissionOverrides',
                            'jobTitle', 'department', 'certifications', 'serviceArea']));
      allow delete: if isSuperAdmin();

      // Client-workspace subcollections (notes, documents, contacts, access
      // info) — only admin pages read or write these today.
      match /clientNotes/{noteId} {
        allow read, write: if isAdmin();
      }
      match /clientDocuments/{docId} {
        allow read, write: if isAdmin();
      }
      match /contacts/{contactId} {
        allow read, write: if isAdmin();
      }
      match /accessInfo/{infoId} {
        allow read, write: if isAdmin();
      }
    }

    match /assignments/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
          || (isClient() && resource.data.clientId == request.auth.uid)
      );
      allow create: if isAdmin();
      allow update: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /workOrders/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && (resource.data.techId == request.auth.uid
              || resource.data.assignedTechnicianId == request.auth.uid))
          || (isClient() && resource.data.clientId == request.auth.uid)
      );
      allow create: if isAdmin();
      allow update: if isAdmin()
          || (isTech() && (resource.data.techId == request.auth.uid
              || resource.data.assignedTechnicianId == request.auth.uid));
      allow delete: if isAdmin();
    }

    match /weeklyLogs/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech();
      allow update: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid
              && resource.data.status == 'Draft');
      allow delete: if isSuperAdmin();
    }

    match /weeklyLogItems/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech() || isAdmin();
      allow update: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /projectDailyLogs/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech() || isAdmin();
      allow update: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /projects/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || isTech()
          || (isClient() && resource.data.clientId == request.auth.uid)
      );
      allow create: if isAdmin();
      allow update: if isAdmin()
          || (isTech() && (
              resource.data.assignedTechnicianIds.hasAny([request.auth.uid])
              || resource.data.projectLeadId == request.auth.uid
          ));
      allow delete: if isSuperAdmin();
    }

    match /projectDocuments/{id} {
      allow read: if isSignedIn() && (isAdmin() || isTech());
      allow create: if isAdmin() || isTech();
      allow delete: if isAdmin();
    }

    match /clients/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && resource.data.uid == request.auth.uid)
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /clientRequests/{id} {
      allow read: if isAdmin()
          || (isSignedIn() && isClient() && (
              resource.data.clientId == request.auth.uid
              || resource.data.clientName == userData().clientCompany
          ));
      // Check request.auth == null FIRST so isAdmin()/isClient() are never called for unauthenticated users
      // (calling those functions when auth is null would error on request.auth.uid and deny the request)
      allow create: if (request.auth == null
              && request.resource.data.status == 'pending_review'
              && !request.resource.data.keys().hasAny(['assignedAdminId', 'adminNotes', 'reviewedAt', 'reviewedBy', 'convertedClientId']))
          || (request.auth != null && (
              isAdmin()
              // Signed-in clients create service tickets with status 'new'
              // (client portal) or 'pending_review' (intake forms)
              || (isClient()
                  && request.resource.data.status in ['new', 'pending_review']
                  && !request.resource.data.keys().hasAny(['assignedAdminId', 'adminNotes', 'reviewedAt', 'reviewedBy', 'convertedClientId']))
          ));
      allow update: if isAdmin()
          || (isSignedIn() && isClient() && (
              resource.data.clientId == request.auth.uid
              || resource.data.clientName == userData().clientCompany
          ) && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    match /serviceRequests/{id} {
      // Public service request form — unauthenticated create allowed
      allow create: if true;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /siteRequests/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && (
              resource.data.clientId == request.auth.uid
              || resource.data.clientName == userData().clientCompany
          ))
      );
      allow create: if isSignedIn() && (isClient() || isAdmin());
      allow update: if isAdmin()
          || (isClient() && (
              resource.data.clientId == request.auth.uid
              || resource.data.clientName == userData().clientCompany
          ) && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    match /sites/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && resource.data.clientId == request.auth.uid)
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /quotes/{quoteId} {
      allow read: if isAdmin()
          || (isSignedIn() && isClient() && resource.data.clientId == request.auth.uid)
          || resource.data.publicToken != null;
      allow create: if isAdmin();
      allow update: if isAdmin()
          || (resource.data.publicToken != null
              && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'approvedByName', 'approvedByEmail', 'approvalNote',
                           'rejectionReason', 'approvedAt', 'rejectedAt', 'viewedAt',
                           'optionalChoices']));
      allow delete: if isSuperAdmin();
    }

    match /invoices/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && (
              resource.data.clientId == request.auth.uid
              || resource.data.clientName == userData().clientCompany
          ))
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /reimbursements/{id} {
      allow read: if isSignedIn() && (
          isPayrollAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech() || isAdmin();
      allow update: if isPayrollAdmin();
      allow delete: if isSuperAdmin();
    }

    match /timeOffRequests/{id} {
      allow read: if isAdmin();
      allow create: if isTech();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /importBatches/{id} {
      allow read, write: if isAdmin();
    }

    match /missingReports/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /notifications/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /broadcasts/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /systemConfig/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /messages/{id} {
      allow read: if isSignedIn();
      // Sender must own the message, and (unless admin) must be permitted to
      // message that recipient per their messagingAllowedRoles + blocklist.
      // Project/group messages (no direct receiverId) skip the recipient check.
      allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && (
              isAdmin()
              || !request.resource.data.keys().hasAny(['receiverId'])
              || request.resource.data.receiverId == null
              || canMessage(request.resource.data.receiverId)
          );
      allow update, delete: if isAdmin();
    }

    // Service plans — the app reads/writes the `plans` collection (the rule
    // previously guarded `planTiers`, which no code references).
    match /plans/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /financialRecords/{id} {
      allow read, write: if isPayrollAdmin();
    }

    match /penaltyEvents/{id} {
      allow read, write: if isPayrollAdmin();
    }

    match /expenses/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech() || isAdmin();
      allow update: if isPayrollAdmin()
          || (isTech() && resource.data.techId == request.auth.uid);
      allow delete: if isPayrollAdmin();
    }

    match /reliabilityEvents/{id} {
      allow read: if isSignedIn() && (isAdmin() || isTech());
      allow write: if isAdmin();
    }

    match /auditLog/{entityId} {
      match /events/{eventId} {
        allow read: if isAdmin();
        allow create: if isSignedIn();
      }
    }

    // ── Collections used by the app that previously had no rules ─────────
    // (no match block means default-deny, which silently broke these pages)

    // CRM pipeline — admins and the sales role (CRM is a sales feature)
    match /leads/{id} {
      allow read, write: if isAdmin() || isSales();
    }
    match /leadActivities/{id} {
      allow read, write: if isAdmin() || isSales();
    }

    // Assets & materials (admin portal only)
    match /materials/{id} {
      allow read, write: if isAdmin();
    }
    match /assets/{id} {
      allow read, write: if isAdmin();
    }
    match /assetAssignments/{id} {
      allow read, write: if isAdmin();
    }

    // Dispatch routes (admin portal only)
    match /routes/{id} {
      allow read, write: if isAdmin();
    }

    // Company planning (admin portal only)
    match /companyGoals/{id} {
      allow read, write: if isAdmin();
    }
    match /companyMilestones/{id} {
      allow read, write: if isAdmin();
    }
    match /recurringTasks/{id} {
      allow read, write: if isAdmin();
    }

    // Reports activity archive (admin portal only)
    match /activityArchive/{id} {
      allow read, write: if isAdmin();
    }

    // Payroll adjustments (payroll audit page)
    match /payrollAdjustments/{id} {
      allow read, write: if isPayrollAdmin();
    }

    // Project payouts — created/managed by admins, technicians read their own
    match /projectPayouts/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.technicianId == request.auth.uid)
      );
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Personnel documents (admin directory)
    match /personnelDocuments/{id} {
      allow read, write: if isAdmin();
    }

    // Trip logs — technicians log their own trips, admins review
    match /tripLogs/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.technicianId == request.auth.uid)
      );
      allow create: if isAdmin()
          || (isTech() && request.resource.data.technicianId == request.auth.uid);
      // Techs update their own trips (check-in arrival, check-out mileage).
      allow update: if isAdmin()
          || (isTech() && resource.data.technicianId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Admin-managed config read across portals (skills list, finance rates)
    match /adminConfig/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}