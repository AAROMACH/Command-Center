rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      let d = userData();
      return d.get('roles', []).hasAny(['super_admin', 'dispatch_admin', 'payroll_admin', 'project_manager'])
          || d.get('role', '') in ['admin', 'super_admin', 'dispatch_admin', 'payroll_admin', 'project_manager'];
    }

    function isSuperAdmin() {
      let d = userData();
      return d.get('roles', []).hasAny(['super_admin']) || d.get('role', '') == 'super_admin';
    }

    function isPayrollAdmin() {
      let d = userData();
      return d.get('roles', []).hasAny(['super_admin', 'payroll_admin'])
          || d.get('role', '') in ['super_admin', 'payroll_admin'];
    }

    function isTech() {
      let d = userData();
      return d.get('roles', []).hasAny(['project_lead', 'field_technician'])
          || d.get('role', '') in ['tech', 'project_lead', 'field_technician'];
    }

    function isClient() {
      let d = userData();
      return d.get('roles', []).hasAny(['client']) || d.get('role', '') == 'client';
    }

    // A tech's own record must stay theirs on update (no handing a log,
    // trip or expense to another tech).
    function keepsField(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // systemConfig/idCounters: exactly one known counter (ID_PREFIXES in
    // src/lib/constants.ts), bumped by exactly 1. Rules can't index into a
    // set, so each prefix is checked; a prefix missing here just makes
    // non-admins fall back to a timestamp id (see lib/generateId.ts).
    function counterStep(k) {
      return request.resource.data.get(k, 0) == resource.data.get(k, 0)
          || request.resource.data.get(k, 0) == resource.data.get(k, 0) + 1;
    }
    function isCounterBump() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.size() == 1
          && changed.hasOnly(['asmt', 'cli', 'creq', 'fnr', 'batch', 'inv', 'lead', 'lact', 'msg', 'msr', 'noti', 'pdis', 'pen', 'plan', 'prj', 'plog', 'pdoc', 'ppay', 'reimb', 'route', 'site', 'sreq', 'svc', 'cint', 'pto', 'tlog', 'uID', 'wlog', 'wli', 'qt', 'wo'])
          && counterStep('asmt')
          && counterStep('cli')
          && counterStep('creq')
          && counterStep('fnr')
          && counterStep('batch')
          && counterStep('inv')
          && counterStep('lead')
          && counterStep('lact')
          && counterStep('msg')
          && counterStep('msr')
          && counterStep('noti')
          && counterStep('pdis')
          && counterStep('pen')
          && counterStep('plan')
          && counterStep('prj')
          && counterStep('plog')
          && counterStep('pdoc')
          && counterStep('ppay')
          && counterStep('reimb')
          && counterStep('route')
          && counterStep('site')
          && counterStep('sreq')
          && counterStep('svc')
          && counterStep('cint')
          && counterStep('pto')
          && counterStep('tlog')
          && counterStep('uID')
          && counterStep('wlog')
          && counterStep('wli')
          && counterStep('qt')
          && counterStep('wo');
    }

    function isSales() {
      let d = userData();
      return d.get('roles', []).hasAny(['sales']) || d.get('role', '') == 'sales';
    }

    // ── Messaging permission enforcement ────────────────────────────────
    // Mirrors the recipient-picker logic: the sender's messagingAllowedRoles
    // and per-user blocklist gate who they may message. Admins are exempt.
    function receiverRoles(receiverId) {
      return get(/databases/$(database)/documents/users/$(receiverId)).data.get('roles', []);
    }
    function messagingRoleAllowed(allowed, receiverId) {
      return allowed == 'all'
        || (allowed == 'admins' && receiverRoles(receiverId).hasAny(['super_admin', 'dispatch_admin', 'payroll_admin', 'project_manager']))
        || (allowed == 'techs'  && receiverRoles(receiverId).hasAny(['field_technician', 'project_lead']))
        || (allowed == 'clients' && receiverRoles(receiverId).hasAny(['client']));
    }
    function canMessage(receiverId) {
      let d = userData();
      let allowed = d.get('messagingAllowedRoles', 'all');
      let blocked = d.get('messagingBlockedClientIds', []);
      return allowed != 'none'
        && !blocked.hasAny([receiverId])
        && (
            // The generic "admin" channel is allowed when admins are permitted
            (receiverId == 'admin' && (allowed == 'all' || allowed == 'admins'))
            // Real user recipients are checked against their roles
            || (receiverId != 'admin' && messagingRoleAllowed(allowed, receiverId))
           );
    }
    // A client may see a project's group thread only when the project
    // belongs to their own company — projects carry the client's company
    // name in `client` (same convention as clientName/clientCompany
    // elsewhere), not a uid.
    function isMyCompanyProject(projectId) {
      let p = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return p.client == userData().clientCompany;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin()
          || (request.auth != null
              && request.auth.uid == userId
              && request.resource.data.approvalStatus == 'pending'
              && !request.resource.data.keys().hasAny(['role', 'clientCompany', 'clientId', 'companyId',
                    'portalAccess', 'primaryPortal', 'permissionOverrides',
                    'messagingAllowedRoles', 'messagingBlockedClientIds', 'hourlyRate', 'payRate'])
              && (!request.resource.data.keys().hasAny(['roles'])
                  || request.resource.data.roles.size() == 0));
      allow update: if isAdmin()
          || (isSignedIn() && request.auth.uid == userId
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['roles', 'role', 'reliabilityScore', 'reliabilityTier', 'status', 'accountStatus',
                            'payoutPreferences', 'hourlyRate', 'adminNotes', 'updatedBy',
                            'approvalStatus', 'approvedAt', 'approvedBy', 'deniedAt', 'deniedBy', 'denialReason',
                            'portalAccess', 'primaryPortal', 'permissionOverrides',
                            'jobTitle', 'department', 'certifications', 'serviceArea',
                            // clientCompany scopes a client's invoices, requests and
                            // project threads; the messaging fields are admin-set limits.
                            'clientCompany', 'clientId', 'companyId',
                            'messagingAllowedRoles', 'messagingBlockedClientIds',
                            'payRate', 'payType', 'currentWorkload']));
      allow delete: if isSuperAdmin();

      // Client-workspace subcollections (notes, documents, contacts, access
      // info) — only admin pages read or write these today.
      match /clientNotes/{noteId} {
        allow read, write: if isAdmin();
      }
      match /clientDocuments/{docId} {
        allow read, write: if isAdmin();
      }
      match /contacts/{contactId} {
        allow read, write: if isAdmin();
      }
      match /accessInfo/{infoId} {
        allow read, write: if isAdmin();
      }
      // Canonical personnel documents — admin manages; the owning user may read
      // their own. Written by the directory detail page.
      match /documents/{docId} {
        allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
        allow write: if isAdmin();
      }
      // Admin-only personnel notes.
      match /techNotes/{noteId} {
        allow read, write: if isAdmin();
      }
    }

    match /assignments/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
          // A helper (additional technician) may read the jobs they assisted on,
          // so the job can surface on their own weekly work log.
          || (isTech() && resource.data.additionalTechnicianIds is list
              && request.auth.uid in resource.data.additionalTechnicianIds)
          || (isClient() && (resource.data.get('clientId', null) == request.auth.uid
              || (myCompany() != '' && resource.data.get('clientName', null) == myCompany())))
      );
      allow create: if isAdmin();
      // Techs may update their own assignment (status, notes, check-in/out)
      // but never the financial fields — those are admin/payroll-audit-only,
      // since effectiveJobPay() reads job.pay live off this doc.
      // ...and only while they are the job's ASSIGNED tech: a stale techId left
      // by an out-of-sync swap (assignedTechnicianId now someone else) can't
      // be used to change status / complete the job.
      allow update: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid
              && (resource.data.get('assignedTechnicianId', null) == null
                  || resource.data.assignedTechnicianId == request.auth.uid)
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['techId', 'assignedTechnicianId', 'assignedTechIds', 'additionalTechnicianIds',
                            'clientId', 'clientName', 'pay', 'payType', 'blendedFixedPay', 'blendedIncludedHours', 'blendedHourlyRate',
                            'finalPay', 'auditReimbursement', 'auditOverhead', 'isAudited', 'auditedAt', 'auditedBy',
                            'source', 'payrollExcluded']));
      allow delete: if isAdmin();
    }

    match /routes/{id} {
      allow read, write: if isAdmin();
    }

    match /workOrders/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && (resource.data.techId == request.auth.uid
              || resource.data.assignedTechnicianId == request.auth.uid))
          || (isClient() && (resource.data.get('clientId', null) == request.auth.uid
              || (myCompany() != '' && resource.data.get('clientName', null) == myCompany())))
      );
      allow create: if isAdmin();
      // Same financial-field lockout as assignments (see comment above) —
      // workOrders and assignments are the same doc shape, just pre/post
      // dispatch.
      allow update: if isAdmin()
          || (isTech() && (resource.data.get('assignedTechnicianId', null) == request.auth.uid
              || (resource.data.techId == request.auth.uid
                  && resource.data.get('assignedTechnicianId', null) == null))
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['techId', 'assignedTechnicianId', 'assignedTechIds', 'additionalTechnicianIds',
                            'clientId', 'clientName', 'pay', 'payType', 'blendedFixedPay', 'blendedIncludedHours', 'blendedHourlyRate',
                            'finalPay', 'auditReimbursement', 'auditOverhead', 'isAudited', 'auditedAt', 'auditedBy',
                            'source', 'payrollExcluded']));
      allow delete: if isAdmin();
    }

    match /weeklyLogs/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      // Techs never write logs directly: rules can't validate what's inside
      // the items/reimbursements arrays, so a tech could rewrite a job's pay
      // or approve their own reimbursement in a Draft. Every tech change goes
      // through /api/weekly-log (Admin SDK), which builds items from the job
      // records and keeps new reimbursements pending. Admins (payroll) edit
      // directly.
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Internal bookkeeping only (never rendered) — one doc per tech per week
    // pointing at that week's open Draft weeklyLogs doc, so filing a
    // completed job can atomically check-and-create inside a transaction.
    // Written by /api/weekly-log (src/lib/server/weekly-log-server.ts).
    match /weeklyLogClaims/{id} {
      allow read, write: if isAdmin();
    }

    match /weeklyLogItems/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      // Legacy collection (no app code reads or writes it) — admin-only so it
      // can't carry tech-entered pay.
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // A tech's dispute filed after their weekly log left Draft (Submitted /
    // Approved / Rejected). Append-only from the tech's side — they can file
    // one but never edit or delete it after the fact — since the underlying
    // log is locked from direct tech edits by then. Only admin resolves them.
    match /payrollDisputes/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isTech() && request.resource.data.techId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /projectDailyLogs/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
          // The project page shows the whole crew's logs to techs on it.
          || (isTech() && resource.data.get('projectId', null) != null
              && isOnProject(resource.data.projectId))
          // Client portal → Projects shows their own projects' daily logs.
          || (isClient() && resource.data.get('projectId', null) != null
              && isMyCompanyProject(resource.data.projectId))
      );
      allow create: if isAdmin()
          || (isTech() && request.resource.data.techId == request.auth.uid);
      allow update: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid && keepsField('techId'));
      allow delete: if isAdmin();
    }

    // A client's company, or '' when the account has none (never matches a
    // real name, so a company-less client can't read company-scoped docs).
    function myCompany() {
      return userData().get('clientCompany', '');
    }

    match /projects/{id} {
      // Projects carry the client's company name in `client` (the new-project
      // form never set clientId), so company match is the real link — the
      // clientId-only rule left every client with zero projects.
      allow read: if isSignedIn() && (
          isAdmin()
          || isTech()
          || isSales()
          || (isClient() && (resource.data.get('clientId', null) == request.auth.uid
              || (myCompany() != '' && resource.data.get('client', null) == myCompany())))
      );
      // Sales can hand a won deal to ops — only as an on-hold project tied
      // to the deal, with no crew assigned. Ops activates and staffs it.
      allow create: if isAdmin()
          || (isSales()
              && request.resource.data.status == 'on-hold'
              && request.resource.data.sourceLeadId is string
              && request.resource.data.assignedTechnicianIds.size() == 0);
      allow update: if isAdmin()
          || (isTech() && (
              resource.data.assignedTechnicianIds.hasAny([request.auth.uid])
              || resource.data.projectLeadId == request.auth.uid
          ));
      allow delete: if isSuperAdmin();
    }

    match /projectDocuments/{id} {
      allow read: if isSignedIn() && (isAdmin() || isTech());
      allow create: if isAdmin() || isTech();
      allow delete: if isAdmin();
    }

    match /clients/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && resource.data.uid == request.auth.uid)
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /clientRequests/{id} {
      allow read: if isAdmin()
          || (isSignedIn() && isClient() && (
              resource.data.clientId == request.auth.uid
              || resource.data.clientName == userData().clientCompany
          ));
      // Check request.auth == null FIRST so isAdmin()/isClient() are never called for unauthenticated users
      // (calling those functions when auth is null would error on request.auth.uid and deny the request)
      allow create: if (request.auth == null
              && request.resource.data.status == 'pending_review'
              && !request.resource.data.keys().hasAny(['assignedAdminId', 'adminNotes', 'reviewedAt', 'reviewedBy', 'convertedClientId']))
          || (request.auth != null && (
              isAdmin()
              // Signed-in clients create service tickets with status 'new'
              // (client portal) or 'pending_review' (intake forms) — and may
              // only attribute the ticket to themselves, never forge another
              // client's clientId/clientName.
              || (isClient()
                  && request.resource.data.status in ['new', 'pending_review']
                  && request.resource.data.clientId == request.auth.uid
                  && !request.resource.data.keys().hasAny(['assignedAdminId', 'adminNotes', 'reviewedAt', 'reviewedBy', 'convertedClientId']))
          ));
      allow update: if isAdmin()
          || (isSignedIn() && isClient() && (
              resource.data.clientId == request.auth.uid
              || resource.data.clientName == userData().clientCompany
          ) && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    match /serviceRequests/{id} {
      // Legacy collection — the public intake form now writes to
      // clientRequests instead (see src/app/public/service-request). No app
      // code writes here anymore, so creation is closed rather than left as
      // an open unauthenticated write.
      allow create: if false;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /siteRequests/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && (
              resource.data.clientId == request.auth.uid
              || resource.data.clientName == userData().clientCompany
          ))
      );
      allow create: if isAdmin()
          || (isSignedIn() && isClient() && request.resource.data.clientId == request.auth.uid);
      allow update: if isAdmin()
          || (isClient() && (
              resource.data.clientId == request.auth.uid
              || resource.data.clientName == userData().clientCompany
          ) && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    match /sites/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && resource.data.clientId == request.auth.uid)
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /quotes/{quoteId} {
      // The public quote-approval page no longer talks to Firestore
      // directly — it goes through /api/public-quote, which does the
      // token-equality check server-side with the Admin SDK. A rules-based
      // public bypass here can't be scoped to "only the doc matching the
      // caller's specific token" (rules can't see query filter values), so
      // `resource.data.publicToken != null` ended up granting anonymous
      // read of every sent quote in the collection. Closed.
      allow read: if isAdmin() || isSales()
          || (isSignedIn() && isClient() && resource.data.clientId == request.auth.uid);
      // Sales quotes (role grants create/edit/send_quote). Approval itself
      // only happens server-side through /api/public-quote.
      allow create: if isAdmin() || isSales();
      allow update: if isAdmin()
          || (isSales() && request.resource.data.status != 'approved');
      allow delete: if isSuperAdmin();
    }

    match /invoices/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isClient() && (
              resource.data.clientId == request.auth.uid
              || resource.data.clientName == userData().clientCompany
          ))
      );
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /reimbursements/{id} {
      allow read: if isSignedIn() && (
          isPayrollAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isAdmin()
          || (isTech() && request.resource.data.techId == request.auth.uid
              && request.resource.data.status == 'pending');
      allow update: if isPayrollAdmin();
      allow delete: if isSuperAdmin();
    }

    match /timeOffRequests/{id} {
      // A tech reads (Profile) and files requests for themselves only.
      allow read: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid);
      allow create: if isAdmin()
          || (isTech() && request.resource.data.techId == request.auth.uid
              && request.resource.data.status == 'pending');
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /importBatches/{id} {
      allow read, write: if isAdmin();
    }

    match /missingReports/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isAdmin()
          || (isTech() && request.resource.data.techId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Written server-side by /api/notify (Admin SDK); clients no longer
    // create these, so an open create only invited forged records.
    match /notifications/{id} {
      allow create: if isAdmin();
      allow read, update, delete: if isAdmin();
    }

    match /broadcasts/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // The friendly-ID counter (wlog-001, asmt-001, ...) is incremented by
    // whoever creates the doc — techs filing their own weekly logs included.
    // Without this, non-admins can't touch systemConfig/idCounters, the
    // transaction in lib/generateId.ts throws, and every non-admin write
    // falls back to the ugly `${prefix}-${Date.now().toString(36)}` id.
    // Any signed-in user may only bump a single counter by one — a reset
    // would re-issue existing ids (wlog-001 ...) and collide with real docs.
    match /systemConfig/idCounters {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.size() == 1
          && request.resource.data.values()[0] == 1;
      allow update: if isAdmin() || (isSignedIn() && isCounterBump());
      allow delete: if isSuperAdmin();
    }

    match /systemConfig/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    function isOnProject(projectId) {
      let p = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return p.get('assignedTechnicianIds', []).hasAny([request.auth.uid])
          || p.get('projectLeadId', null) == request.auth.uid;
    }

    function canReadMessage() {
      return isAdmin()
          || isTech()
          || resource.data.senderId == request.auth.uid
          || resource.data.get('receiverId', null) == request.auth.uid
          || (isClient() && resource.data.get('projectId', null) != null
              && isMyCompanyProject(resource.data.projectId));
    }

    match /messages/{id} {
      // Staff (admin/tech) see the whole collection — matches the existing
      // company-wide-visibility model already used for `projects` (any tech
      // can read any project). Clients are scoped: their own sent/received
      // messages, plus group threads on projects that belong to their own
      // company — never another client's DMs or another company's project
      // chat.
      allow read: if isSignedIn() && canReadMessage();
      // Sender must own the message, and (unless admin) must be permitted to
      // message that recipient per their messagingAllowedRoles + blocklist.
      // Project/group messages (no direct receiverId) skip the recipient check.
      allow create: if isSignedIn()
          && request.resource.data.senderId == request.auth.uid
          && (
              isAdmin()
              || !request.resource.data.keys().hasAny(['receiverId'])
              || request.resource.data.receiverId == null
              || canMessage(request.resource.data.receiverId)
          );
      // Anyone who can see a message may add THEMSELVES to readBy (read
      // receipts) and change nothing else. Admin-only before, so unread
      // counts never cleared for techs and clients.
      allow update: if isAdmin()
          || (isSignedIn() && canReadMessage()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'read'])
              && request.resource.data.get('read', true) == true
              && request.resource.data.readBy is list
              && request.resource.data.readBy.toSet()
                  .difference(resource.data.get('readBy', []).toSet()).hasOnly([request.auth.uid])
              && resource.data.get('readBy', []).toSet()
                  .difference(request.resource.data.readBy.toSet()).size() == 0);
      allow delete: if isAdmin();
    }

    // Service plans — the app reads/writes the `plans` collection (the rule
    // previously guarded `planTiers`, which no code references).
    match /plans/{id} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /financialRecords/{id} {
      allow read, write: if isPayrollAdmin();
    }

    // Admins see and record reliability events (Directory, Intel, Archives
    // and the job panel all show them); a tech may read their own (Profile).
    // Previously payroll-admin-only, so those screens showed 0 for everyone
    // else.
    match /penaltyEvents/{id} {
      allow read: if isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /expenses/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.techId == request.auth.uid)
      );
      allow create: if isAdmin()
          || (isTech() && request.resource.data.techId == request.auth.uid
              && request.resource.data.get('status', 'Pending') == 'Pending');
      // Once payroll has acted on an expense (status left 'pending'), the
      // tech can no longer edit it — only re-submit/withdraw while pending.
      allow update: if isPayrollAdmin()
          || (isTech() && resource.data.techId == request.auth.uid
              && resource.data.status == 'Pending'
              && keepsField('techId') && keepsField('status'));
      allow delete: if isPayrollAdmin();
    }

    match /reliabilityEvents/{id} {
      allow read: if isSignedIn() && (isAdmin() || isTech());
      allow write: if isAdmin();
    }

    match /auditLog/{entityId} {
      match /events/{eventId} {
        allow read: if isAdmin();
        // The event must record the real actor — otherwise anyone signed in
        // could plant an audit entry attributed to someone else.
        allow create: if isSignedIn() && request.resource.data.changedBy == request.auth.uid;
      }
    }

    // ── Collections used by the app that previously had no rules ─────────
    // (no match block means default-deny, which silently broke these pages)

    // CRM pipeline — admins and the sales role (CRM is a sales feature)
    match /leads/{id} {
      allow read, write: if isAdmin() || isSales();
    }
    match /leadActivities/{id} {
      allow read, write: if isAdmin() || isSales();
    }
    match /crmCompanies/{id} {
      allow read, write: if isAdmin() || isSales();
    }
    match /crmContacts/{id} {
      allow read, write: if isAdmin() || isSales();
    }

    // Assets & materials (admin portal only)
    match /materials/{id} {
      allow read, write: if isAdmin();
    }
    match /assets/{id} {
      allow read, write: if isAdmin();
    }
    match /assetAssignments/{id} {
      allow read, write: if isAdmin();
    }

    // Company planning (admin portal only)
    match /companyGoals/{id} {
      allow read, write: if isAdmin();
    }
    match /companyMilestones/{id} {
      allow read, write: if isAdmin();
    }
    match /recurringTasks/{id} {
      allow read, write: if isAdmin();
    }

    // Reports activity archive (admin portal only)
    match /activityArchive/{id} {
      allow read, write: if isAdmin();
    }

    // Payroll adjustments (payroll audit page)
    match /payrollAdjustments/{id} {
      allow read, write: if isPayrollAdmin();
    }

    // Project payouts — created/managed by admins, technicians read their own
    match /projectPayouts/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.technicianId == request.auth.uid)
      );
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Personnel documents (admin directory)
    match /personnelDocuments/{id} {
      allow read, write: if isAdmin();
    }

    // Trip logs — technicians log their own trips, admins review
    match /tripLogs/{id} {
      allow read: if isSignedIn() && (
          isAdmin()
          || (isTech() && resource.data.technicianId == request.auth.uid)
      );
      allow create: if isAdmin()
          || (isTech() && request.resource.data.technicianId == request.auth.uid);
      // Techs update their own trips (check-in arrival, check-out mileage).
      allow update: if isAdmin()
          || (isTech() && resource.data.technicianId == request.auth.uid
              && keepsField('technicianId'));
      allow delete: if isAdmin();
    }

    // Admin-managed config read across portals (skills list, finance rates)
    match /adminConfig/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}